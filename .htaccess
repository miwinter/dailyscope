RewriteEngine On

# Une seule URL d'accueil, y compris pour /index.html.
RewriteCond %{THE_REQUEST} \s/+([?\s]|index\.html[?\s]) [NC]
RewriteRule ^(index\.html)?$ https://www.dailyscope.ai/en/ [R=301,L,NE]

# Normalise le domaine puis le protocole, en tenant compte d'un proxy HTTPS.
RewriteCond %{HTTP_HOST} !^www\.dailyscope\.ai$ [NC]
RewriteRule ^ https://www.dailyscope.ai%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://www.dailyscope.ai%{REQUEST_URI} [R=301,L,NE]

# Une archive index.html a pour URL canonique son dossier.
RewriteCond %{THE_REQUEST} \s/[^?\s]*/index\.html[?\s] [NC]
RewriteRule ^(.*/)?index\.html$ https://www.dailyscope.ai/$1 [R=301,L,NE]

# Les autres pages ont une URL sans extension.
RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[?\s] [NC]
RewriteRule ^ https://www.dailyscope.ai/%1 [R=301,L,NE]

# Sert /en/AAAA-MM-JJ/1 depuis le fichier 1.html, aussi dans les sous-dossiers.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [END]

ErrorDocument 404 /
